# 复制为 .env 后填写。不要把 .env 提交到 Git。
MYIDEA_SECRET_KEY=replace-with-a-long-random-secret

MYIDEA_MYSQL_HOST=127.0.0.1
MYIDEA_MYSQL_PORT=3306
MYIDEA_MYSQL_USER=root
MYIDEA_MYSQL_PASSWORD=replace-with-your-password
MYIDEA_MYSQL_DATABASE=myidea_recommend

# 可选：用于补全 TMDB 海报。
MYIDEA_TMDB_KEY=

# 可选：演示时跳过推荐模型预热，加快启动。
MYIDEA_FAST_START=0
